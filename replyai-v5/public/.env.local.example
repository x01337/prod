# ── Required ──────────────────────────────────────────────────────────────────
# Change this to a strong random string before deploying!
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# LOCAL: leave empty → SQLite (auto-created at data/ars.db)
# PRODUCTION: set to your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── AI Fallback (optional) ────────────────────────────────────────────────────
# Set AI_ENABLED=true + add your OpenRouter API key to enable AI escalation
# for low-confidence matcher results. Free models available.
AI_ENABLED=false
# AI_API_KEY=sk-or-...
# AI_MODEL=mistralai/mistral-7b-instruct:free

# ── Site URL (used by AI layer for OpenRouter referer header) ─────────────────
# SITE_URL=https://yourdomain.com
