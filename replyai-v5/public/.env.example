# ═══════════════════════════════════════════════════════
#  ReplyAI — Environment Variables
#  cp .env.example .env   then fill in your values
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=

# ── DATABASE ─────────────────────────────────────────────
# Leave empty → SQLite (local dev, data/ars.db)
# Set for production:
#   Railway:  postgresql://user:pass@host:5432/dbname
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ── APP URL ──────────────────────────────────────────────
# Used in reset-password emails and webhook URLs
SITE_URL=http://localhost:3000

# ── EMAIL (optional — for password reset emails) ─────────
# Without this, reset links are printed to the server console
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ── STRIPE (optional — enables paid plans) ───────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# dashboard.stripe.com → Products → your product → Pricing
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BIZ_MONTHLY=
STRIPE_PRICE_BIZ_ANNUAL=

# ── WHATSAPP BUSINESS (optional) ─────────────────────────
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── AI FALLBACK (optional) ───────────────────────────────
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=mistralai/mistral-7b-instruct:free

# ── DOCKER ONLY ──────────────────────────────────────────
POSTGRES_PASSWORD=
APP_PORT=3000

# ── CLOUDFLARE TUNNEL (optional public URL) ──────────────
# dash.cloudflare.com → Zero Trust → Access → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
