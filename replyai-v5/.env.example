# ════════════════════════════════════════════════════════════════
#  ReplyAI — Environment Variables
#  Copy this file: cp .env.example .env
#  Then fill in your values below.
#  NEVER commit the .env file to git.
# ════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Secret key for signing login tokens.
# Generate one: openssl rand -hex 32
JWT_SECRET=

# ── DATABASE ──────────────────────────────────────────────────────────────────

# REQUIRED on Vercel — SQLite cannot persist on serverless. Use PostgreSQL:
# (Supabase free tier: supabase.com, Neon: neon.tech, Railway: railway.app)
# For production, paste a PostgreSQL connection string:
#   Railway:  postgresql://user:pass@host:5432/dbname
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ── APP URL ───────────────────────────────────────────────────────────────────

# The public URL of your site — used in reset-password emails and webhooks.
# Local dev:   http://localhost:3000
# Production:  https://yourapp.railway.app  or  https://yourdomain.com
SITE_URL=http://localhost:3000

# ── EMAIL (optional) ──────────────────────────────────────────────────────────
# Used for: password reset emails, email verification.
# Without this, reset links are printed to the server console (fine for testing).

# Your Gmail address
EMAIL_USER=

# Gmail App Password (NOT your regular password).
# Create one at: myaccount.google.com → Security → App Passwords
EMAIL_PASS=

# Optional: sender name/address shown in emails
EMAIL_FROM=

# ── WHATSAPP BUSINESS API (optional) ─────────────────────────────────────────
# Only needed if you use the WhatsApp auto-response feature.
# Get these from: developers.facebook.com → Your App → WhatsApp

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ── AI FALLBACK (optional) ────────────────────────────────────────────────────
# When enabled, low-confidence FAQ matches are sent to an AI for a better answer.
# Uses OpenRouter (openrouter.ai) — free tier available.

# Set to "true" to enable AI fallback
AI_ENABLED=false

# Your OpenRouter API key (openrouter.ai/keys)
AI_API_KEY=

# Model to use (free models at openrouter.ai/models?q=free)
AI_MODEL=mistralai/mistral-7b-instruct:free

# ── DOCKER-ONLY ───────────────────────────────────────────────────────────────
# Only used when running via docker-compose.

# Password for the PostgreSQL container
POSTGRES_PASSWORD=

# Host port the app is exposed on (default 3000)
APP_PORT=3000

# ── CLOUDFLARE TUNNEL (optional) ─────────────────────────────────────────────
# Instantly share your app via a public URL without opening firewall ports.
# Get a free token at: dash.cloudflare.com → Zero Trust → Access → Tunnels

CLOUDFLARE_TUNNEL_TOKEN=
