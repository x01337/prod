# DATABASE
# Leave empty -> SQLite (dev). Set for prod: Neon, Supabase, Railway
DATABASE_URL=

# AUTH - REQUIRED: 32+ random chars. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# EMAIL (nodemailer / Gmail)
# Use Gmail App Password: myaccount.google.com/apppasswords (2FA required)
EMAIL_USER=your@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# Optional custom SMTP:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false

# WHATSAPP CLOUD API
# From: developers.facebook.com -> App -> WhatsApp -> API Setup
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret for HMAC signature verification (REQUIRED in production)
# From: developers.facebook.com -> App -> Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=

# AI FALLBACK (optional, free at openrouter.ai)
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=mistralai/mistral-7b-instruct:free

# APP
SITE_URL=https://yourdomain.com
SLOT_LIMIT=5

# ── STRIPE (optional — needed for paid plans) ────────────────────────────────
# Get these from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from: dashboard.stripe.com → Products → (your product) → Pricing
# Create two products: "Pro" and "Business", each with monthly + annual prices
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BIZ_MONTHLY=
STRIPE_PRICE_BIZ_ANNUAL=
